# Claude temp documents
.scratch/*
docs/adr/*

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Keep the TensorRT-RTX runtime redistributables. The NNERuntimeTRT plugin loads these prebuilt NVIDIA DLLs at
# runtime; they are NOT regenerated by a build, so a clean of ignored Binaries would break inference (and the HUD).
# Tracked via LFS (see the *.dll rule in .gitattributes) so they survive cleans and live on the branch.
!Plugins/NNERuntimeTRT/Binaries/ThirdParty/
!Plugins/NNERuntimeTRT/Binaries/ThirdParty/**

# Builds
HMI/**/Build/*
!Build/*/
Build/*/**

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# OS/platform generated files.

# Windows
ehthumbs.db
Thumbs.db

# Mac OS X
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# vim
[._]*.s[a-w][a-z]
[._]s[a-w][a-z]
*.un~
Session.vim
.netrwhist

# Visual Studio
.vs
.vsconfig
*.sln
